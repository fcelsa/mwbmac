/* Condivisione e blocco */
"Clipboard" = "Appunti";
"Share the clipboard with the PC" = "Condividi gli appunti con il PC";
"Text and images, in both directions. Requires “Share clipboard” in Mouse Without Borders on the PC." = "Testo e immagini, nelle due direzioni. Richiede l'opzione “Share clipboard” di Mouse Without Borders sul PC.";
"Sleep" = "Stop";
"Keep the other computers awake" = "Tieni svegli gli altri computer";
"While you use the Mac, the PC doesn't start the screen saver or go to sleep. Activity on the PC keeps the Mac awake when the PC has the same option on." = "Mentre usi il Mac, il PC non avvia il salvaschermo e non va in stop. L'attività sul PC tiene sveglio il Mac, se sul PC è attiva la stessa opzione.";
"When the Mac goes to sleep the PC is told right away; on wake the connection resumes as soon as the network is back." = "Quando il Mac va in stop il PC lo sa subito; al risveglio la connessione riprende appena la rete è disponibile.";
"Screen lock" = "Blocco schermo";
"Lock the Mac and the PC together" = "Blocca insieme Mac e PC";
"PC shortcut" = "Scorciatoia del PC";
"⌃⌘Q on the Mac also locks the PC; Win+L sent to the PC, or the shortcut pressed twice on the PC, also locks the Mac. The PC shortcut is the “lock all machines” one set in PowerToys → Mouse Without Borders, written like Win+Ctrl+Alt+L." = "⌃⌘Q sul Mac blocca anche il PC; Win+L inviato al PC, o la scorciatoia premuta due volte sul PC, bloccano anche il Mac. La scorciatoia del PC è quella “blocca tutte le macchine” impostata in PowerToys → Mouse Without Borders, nella forma Win+Ctrl+Alt+L.";

/* Messaggi */
"The base port is not valid." = "La porta base non è valida.";
"The emergency shortcut needs at least ⌃, ⌥ or ⌘." = "La scorciatoia di emergenza richiede almeno ⌃, ⌥ o ⌘.";
"Invalid lock shortcut: use modifiers (Win, Ctrl, Alt, Shift) and a key A–Z or 0–9, e.g. Win+Ctrl+Alt+L." = "Scorciatoia di blocco non valida: modificatori (Win, Ctrl, Alt, Shift) e un tasto A–Z o 0–9, per esempio Win+Ctrl+Alt+L.";
"The Mac's name can't be empty." = "Il nome del Mac non può essere vuoto.";
"Settings applied." = "Impostazioni applicate.";
