"Keyboard on the PC" = "Tastiera sul PC";
"Windows keyboard layout" = "Layout di tastiera di Windows";
"Italian" = "Italiano";
"US" = "Americano";
"⌘ Command becomes" = "⌘ Comando diventa";
"⌃ Control becomes" = "⌃ Controllo diventa";
"⌥ Option becomes" = "⌥ Opzione diventa";
"Right ⌥ Option is AltGr" = "⌥ Opzione destro come AltGr";
"Types characters such as @ # [ ] { } on the Italian layout." = "Per digitare caratteri come @ # [ ] { } con il layout italiano.";
"Mouse" = "Mouse";
"Invert scroll direction" = "Inverti il verso di scorrimento";
"Emergency shortcut" = "Scorciatoia di emergenza";
